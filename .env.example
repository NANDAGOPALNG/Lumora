# FastAPI Application Configuration
# Copy this file to .env and update values for your environment

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Database
DATABASE_URL=Enter your database URL here

# Ingestion / Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Document Storage
# DOCUMENT_STORAGE_BACKEND selects where NEW uploads are written:
#   local - files on this server's disk (development / tests; the default)
#   r2    - Cloudflare R2 object storage (production on Render Free)
# Existing documents are always read from the provider that stored them.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=storage/documents
MAX_DOCUMENT_SIZE_MB=20

# Cloudflare R2 (only required when DOCUMENT_STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# External Services (Optional - required depending on features)
OPENAI_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# Environment
ENVIRONMENT=development

# Jina AI (remote embeddings + reranking). One key serves both APIs.
JINA_API_KEY=Enter your Jina API key here

# Embeddings (Jina Embeddings API, 1024 dimensions)
EMBEDDING_MODEL_NAME=jina-embeddings-v3
EMBEDDING_BATCH_SIZE=32

# Reranking (Jina Reranker API)
JINA_RERANKER_MODEL_NAME=jina-reranker-v2-base-multilingual
JINA_RERANKER_URL=https://api.jina.ai/v1/rerank

#Qdrant Configuration
QDRANT_URL=Enter your Qdrant URL here
QDRANT_API_KEY=Enter your Qdrant API key here

# Application Info (usually auto-set, don't modify)
APP_NAME=Lumora API
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI Knowledge Platform