# FastAPI Application Configuration
# Copy this file to .env and update values for your environment

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Database
DATABASE_URL=Enter your database URL here

# Ingestion / Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Document Storage
DOCUMENT_STORAGE_PATH=storage/documents
MAX_DOCUMENT_SIZE_MB=20

# External Services (Optional - required depending on features)
OPENAI_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# Environment
ENVIRONMENT=development

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

#Qdrant Configuration
QDRANT_URL=Enter your Qdrant URL here
QDRANT_API_KEY=Enter your Qdrant API key here

# Application Info (usually auto-set, don't modify)
APP_NAME=Lumora API
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI Knowledge Platform