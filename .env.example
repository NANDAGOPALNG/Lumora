# FastAPI Application Configuration
# Copy this file to .env and update values for your environment

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Database
DATABASE_URL=sqlite+aiosqlite:///./lumora.db

# External Services (Optional - required depending on features)
OPENAI_API_KEY=
PINECONE_API_KEY=
CHROMADB_PATH=./data/chromadb

# Environment
ENVIRONMENT=development

# Application Info (usually auto-set, don't modify)
APP_NAME=Lumora API
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI Knowledge Platform